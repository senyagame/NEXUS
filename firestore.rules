rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Правила для коллекции избранного
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Правила для коллекции заметок
    match /notes/{noteId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // === ИЗМЕНЕННЫЕ ПРАВИЛА ДЛЯ КОЛЛЕКЦИИ 'users' ===
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId; // Чтение своего профиля
      allow write: if request.auth != null && request.auth.uid == userId; // Запись своего профиля
    }

    // === НОВЫЕ ПРАВИЛА ДЛЯ КОЛЛЕКЦИИ 'delete-users' ===
    match /delete-users/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.content_confirm == "Я хочу удалить аккаунт.") // <<-- ЭТОТ БЛОК ГЛАВНЫЙ
                    && request.resource.data.status == "pending";
      allow read, update, delete: if false;
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 👤 Правила для коллекции пользователей
    // Изменено: Чтение разрешено всем для поддержки входа по логину.
    // Это безопасно, так как здесь не хранятся пароли.
    match /users/{userId} {
      allow read; // <- ВОТ ИЗМЕНЕНИЕ
      
      // Создание и обновление разрешено только авторизованному владельцу документа
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // ⭐ Правила для коллекции избранного
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 📝 Правила для коллекции заметок
    match /notes/{noteId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // 🗑️ Правила для запросов на удаление аккаунта
    match /delete-users/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.content_confirm == "Я хочу удалить аккаунт"
        && request.resource.data.status == "pending";
        
      // Запрещаем чтение и изменение запросов после создания
      allow read, update, delete: if false;
    }
  }
}